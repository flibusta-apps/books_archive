ARCHIVE_DIR=/path/to/archives
# Replace with a strong secret before starting the service.
API_KEY=replace-with-a-strong-secret
# Explicit public-access opt-in, only when API_KEY is absent/empty:
# ALLOW_UNAUTHENTICATED=true
# INPX_PATH=/path/to/catalog.inpx
INPX_MAX_DECOMPRESSED_BYTES=2147483648
INPX_MAX_RECORDS=20000000
